[Unit]
Description=Grafana
After=backend-network.service
Requires=monitoring-grafana-data.volume

[Container]
Image=zot.innokentii-kozlov.com/docker/grafana/grafana-oss:13.0.1
ContainerName=monitoring-grafana
Network=frontend.network
Network=backend.network
Volume=%h/.config/config/monitoring/monitoring-grafana/provisioning:/etc/grafana/provisioning:z
Volume=%h/.config/config/monitoring/monitoring-grafana/dashboards:/etc/grafana/dashboards:z
Volume=%h/.config/config/monitoring/monitoring-grafana/grafana.ini:/etc/grafana/grafana.ini:z
Volume=monitoring-grafana-data:/var/lib/grafana:z
Environment=GF_INSTALL_PLUGINS=grafana-piechart-panel
Secret=monitoring-grafana-GF_AUTH_GENERIC_OAUTH_CLIENT_ID,type=env,target=GF_AUTH_GENERIC_OAUTH_CLIENT_ID
Secret=monitoring-grafana-GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET,type=env,target=GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET

[Service]
Restart=always

[Install]
WantedBy=default.target

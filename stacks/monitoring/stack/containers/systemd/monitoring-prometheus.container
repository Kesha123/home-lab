[Unit]
Description=Prometheus
After=backend-network.service
Requires=monitoring-prometheus-data.volume

[Container]
Image=zot.innokentii-kozlov.com/docker/prom/prometheus:v3
ContainerName=monitoring-prometheus
Network=backend.network
Volume=%h/.config/config/monitoring/monitoring-prometheus:/etc/prometheus:ro,z
Volume=monitoring-prometheus-data:/prometheus
Exec=--config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/prometheus --storage.tsdb.retention.time=365d --storage.tsdb.retention.size=10GB --web.enable-lifecycle

[Service]
Restart=always

[Install]
WantedBy=default.target

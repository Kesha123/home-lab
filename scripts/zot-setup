#!/usr/bin/env sh
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TOFU_DIR="$REPO_ROOT/iac/authentik/tofu"
OUT_DIR="$SCRIPT_DIR/target"
OUT_FILE="$OUT_DIR/oidc-credentials.json"

usage() {
  echo "Usage: zot-setup <subcommand>"
  echo ""
  echo "Subcommands:"
  echo "  generate-oidc-credentials  Render authentik tofu outputs to $OUT_FILE"
  exit 1
}

cmd_generate_oidc_credentials() {
  mkdir -p "$OUT_DIR"
  tofu -chdir="$TOFU_DIR" output -json \
    | jq '{clientid: .zot_client_id.value, clientsecret: .zot_client_secret.value}' \
    > "$OUT_FILE"
  echo "Wrote $OUT_FILE"
}

main() {
  case "${1:-}" in
    generate-oidc-credentials) shift; cmd_generate_oidc_credentials "$@" ;;
    *) usage ;;
  esac
}

main "$@"

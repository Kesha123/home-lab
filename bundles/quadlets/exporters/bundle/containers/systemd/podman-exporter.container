[Unit]
Description=Podman Exporter
After=backend-network.service podman.socket
Requires=podman.socket

[Container]
Image=zot.innokentii-kozlov.com/quay/navidys/prometheus-podman-exporter:v1.21.2
ContainerName=podman-exporter
Network=backend.network
UserNS=keep-id:uid=65534
SecurityLabelType=container_runtime_t
Environment=CONTAINER_HOST=unix:///run/podman/podman.sock
Volume=%t/podman/podman.sock:/run/podman/podman.sock
Exec=--collector.enable-all --collector.enhance-metrics

[Service]
Restart=always

[Install]
WantedBy=default.target

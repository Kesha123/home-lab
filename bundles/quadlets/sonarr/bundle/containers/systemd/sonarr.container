[Unit]
Description=Sonarr
After=backend-network.service
Requires=sonarr-config.volume transmission-downloads.volume

[Container]
Image=zot.innokentii-kozlov.com/docker/linuxserver/sonarr:4.0.20
ContainerName=sonarr
Network=backend.network
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Europe/Helsinki
Environment=SONARR__AUTH__METHOD=External
Environment=SONARR__AUTH__REQUIRED=DisabledForLocalAddresses
Environment=SONARR__APP__LAUNCHBROWSER=False
Secret=sonarr-SONARR__AUTH__APIKEY,type=env,target=SONARR__AUTH__APIKEY
Volume=sonarr-config:/config:z
Volume=transmission-downloads:/downloads:z
HealthCmd=curl -fsS http://localhost:8989/ping
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=2m
HealthTimeout=10s

[Service]
Restart=always

[Install]
WantedBy=default.target

[Unit]
Description=Seerr
After=backend-network.service
Requires=seerr-config.volume

[Container]
Image=zot.innokentii-kozlov.com/ghcr/seerr-team/seerr:v3.4.1
ContainerName=seerr
Network=backend.network
Environment=TZ=Europe/Helsinki
Volume=seerr-config:/app/config:z
HealthCmd=wget --no-verbose --tries=1 --spider http://localhost:5055/api/v1/settings/public
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=2m
HealthTimeout=10s

[Service]
Restart=always

[Install]
WantedBy=default.target

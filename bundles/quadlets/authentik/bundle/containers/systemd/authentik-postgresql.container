[Unit]
Description=Authentik PostgreSQL
After=backend-network.service
Requires=authentik-postgresql-data.volume

[Container]
Image=zot.innokentii-kozlov.com/docker/library/postgres:16-alpine
ContainerName=authentik-postgresql
Network=backend.network
Environment=POSTGRES_DB=authentik
Secret=authentik-POSTGRES_USER,type=env,target=POSTGRES_USER
Secret=authentik-POSTGRES_PASSWORD,type=env,target=POSTGRES_PASSWORD
Volume=authentik-postgresql-data.volume:/var/lib/postgresql/data
HealthCmd=pg_isready -d $${POSTGRES_DB} -U $${POSTGRES_USER}
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=20s
HealthRetries=5

[Service]
Restart=always

[Install]
WantedBy=default.target

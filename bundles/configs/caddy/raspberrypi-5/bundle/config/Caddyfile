{
    admin :2019
    metrics
}

(route53_tls) {
    tls {
        dns route53 {
            hosted_zone_id Z07266063B6JW9NSLBQB
        }
        resolvers 8.8.8.8 1.1.1.1
    }
}

node-exporter.raspberrypi-5.innokentii-kozlov.com {
    import route53_tls
    reverse_proxy node-exporter:9100
}

podman-exporter.raspberrypi-5.innokentii-kozlov.com {
    import route53_tls
    reverse_proxy podman-exporter:9882
}

caddy-exporter.raspberrypi-5.innokentii-kozlov.com {
    import route53_tls
    reverse_proxy /metrics localhost:2019
}

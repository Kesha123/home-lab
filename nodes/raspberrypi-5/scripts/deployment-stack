#!/usr/bin/env sh
set -euo pipefail

usage() {
  echo "Usage: deployment-stack <subcommand> [args]"
  echo ""
  echo "Subcommands:"
  echo "  sync-container-stack <stack> <bundle> <version> <digest>  Pull, verify, and install a bundle into the stack's config dirs"
  exit 1
}

cmd_sync_container_stack() {
  if [ $# -ne 4 ]; then
    echo "Usage: deployment-stack sync-container-stack <stack> <bundle> <version> <digest>" >&2
    exit 1
  fi

  stack="$1"
  bundle="$2"
  version="$3"
  digest="$4"
  ref="${bundle}:${version}"

  podman artifact pull "$ref"

  actual="$(podman artifact inspect -f '{{.Digest}}' "$ref")"
  if [ "$actual" != "$digest" ]; then
    echo "ERROR: digest mismatch for $ref: expected $digest, got $actual" >&2
    exit 1
  fi

  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  podman artifact extract "$ref" "$tmp"
  tar -xzf "$tmp"/*.tar.gz --no-same-owner -C "$tmp"

  quadlet_dir="/home/admin/.config/containers/systemd/${stack}"
  config_dir="/home/admin/.config/config/${stack}"
  mkdir -p "$quadlet_dir" "$config_dir"
  if [ -d "$tmp/containers/systemd" ]; then
    cp -r "$tmp"/containers/systemd/. "$quadlet_dir"/
  fi
  if [ -d "$tmp/config" ]; then
    cp -r "$tmp"/config/. "$config_dir"/
  fi

  podman artifact rm "$ref"
}

main() {
  case "${1:-}" in
    sync-container-stack)
      shift
      cmd_sync_container_stack "$@"
      ;;
    *)
      usage
      ;;
  esac
}

main "$@"

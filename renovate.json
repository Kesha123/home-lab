{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Track upstream container images referenced through the zot mirror and keep bundle tags in sync",
  "timezone": "Europe/Helsinki",
  "prConcurrentLimit": 1,
  "labels": ["renovate"],
  "dependencyDashboard": true,
  "ignorePaths": [],
  "prBodyNotes": [
    "The `bundle-release` workflow runs automatically on this PR: it republishes all bundles to zot. Builds are reproducible, so unaffected bundles keep their existing digest; update `nodes/*/deployment-stack.yaml` digests manually after merging."
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "docker.io images pulled through the zot mirror",
      "managerFilePatterns": ["/^bundles\\/quadlets\\/[^/]+\\/bundle\\/containers\\/systemd\\/[^/]+\\.container$/"],
      "matchStrings": ["Image=zot\\.innokentii-kozlov\\.com/docker/(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)"],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://index.docker.io",
      "depNameTemplate": "{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "ghcr.io images pulled through the zot mirror",
      "managerFilePatterns": ["/^bundles\\/quadlets\\/[^/]+\\/bundle\\/containers\\/systemd\\/[^/]+\\.container$/"],
      "matchStrings": ["Image=zot\\.innokentii-kozlov\\.com/ghcr/(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)"],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://ghcr.io",
      "depNameTemplate": "{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "quay.io images pulled through the zot mirror",
      "managerFilePatterns": ["/^bundles\\/quadlets\\/[^/]+\\/bundle\\/containers\\/systemd\\/[^/]+\\.container$/"],
      "matchStrings": ["Image=zot\\.innokentii-kozlov\\.com/quay/(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)"],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://quay.io",
      "depNameTemplate": "{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "gcr.io images pulled through the zot mirror",
      "managerFilePatterns": ["/^bundles\\/quadlets\\/[^/]+\\/bundle\\/containers\\/systemd\\/[^/]+\\.container$/"],
      "matchStrings": ["Image=zot\\.innokentii-kozlov\\.com/gcr/(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)"],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://gcr.io",
      "depNameTemplate": "{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "data.forgejo.org images pulled through the zot mirror",
      "managerFilePatterns": ["/^bundles\\/quadlets\\/[^/]+\\/bundle\\/containers\\/systemd\\/[^/]+\\.container$/"],
      "matchStrings": ["Image=zot\\.innokentii-kozlov\\.com/forgejo/(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)"],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://data.forgejo.org",
      "depNameTemplate": "{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "codeberg.org images pulled through the zot mirror",
      "managerFilePatterns": ["/^bundles\\/quadlets\\/[^/]+\\/bundle\\/containers\\/systemd\\/[^/]+\\.container$/"],
      "matchStrings": ["Image=zot\\.innokentii-kozlov\\.com/codeberg/(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)"],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://codeberg.org",
      "depNameTemplate": "{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "direct ghcr.io references (not mirrored in the Image line)",
      "managerFilePatterns": ["/^bundles\\/quadlets\\/[^/]+\\/bundle\\/containers\\/systemd\\/[^/]+\\.container$/"],
      "matchStrings": ["Image=ghcr\\.io/(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)"],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://ghcr.io",
      "depNameTemplate": "{{{depName}}}"
    },
    {
      "customType": "regex",
      "description": "self-update of the Renovate job image used by the scheduled workflow",
      "managerFilePatterns": ["/^\\.forgejo\\/workflows\\/renovate\\.yml$/"],
      "matchStrings": ["image: zot\\.innokentii-kozlov\\.com/ghcr/renovatebot/renovate:(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://ghcr.io",
      "depNameTemplate": "renovatebot/renovate"
    }
  ],
  "packageRules": [
    {
      "description": "Built-in quadlet manager is disabled: custom managers map zot mirror paths to the upstream registries instead",
      "matchManagers": ["quadlet"],
      "enabled": false
    },
    {
      "description": "Group every container image update into a single PR so bundle releases and deployment-stack.yaml edits never conflict",
      "matchDatasources": ["docker"],
      "allowedVersions": "/^v?\\d+(\\.\\d+){0,2}(-[A-Za-z0-9.]+)?$/",
      "groupName": "container images",
      "groupSlug": "container-images",
      "commitMessageTopic": "container images"
    }
  ]
}
